{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supply",
  "title": "supply",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "kind",
    "accelerator_ids",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "supply"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "oem-direct",
        "enterprise-distributor",
        "used-market",
        "auction",
        "cloud",
        "integrator",
        "regional-reseller",
        "broker",
        "self-build",
        "unknown"
      ]
    },
    "vendor": {
      "type": [
        "string",
        "null"
      ],
      "description": "who ultimately supplies the part"
    },
    "accelerator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "bare record ids of the accelerators obtainable here"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "geographic market served"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "sales motion: direct-quote | reseller | marketplace | auction | rental | on-prem-cloud | contact-sales"
    },
    "price_usd": {
      "type": [
        "number",
        "null"
      ],
      "description": "unit or configured-system price; unit basis in notes"
    },
    "price_basis": {
      "type": [
        "string",
        "null"
      ],
      "description": "what the price covers: bare card, SXM module, full 8-GPU server, annual rental, per-hour cloud, incl. tax/shipping, etc."
    },
    "availability": {
      "enum": [
        "in-stock",
        "lead-time",
        "backorder",
        "allocation-only",
        "discontinued",
        "unknown"
      ]
    },
    "lead_time_weeks": {
      "type": [
        "number",
        "null"
      ]
    },
    "export_controlled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "true if sale is restricted by region/entity; see notes for the regime"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
