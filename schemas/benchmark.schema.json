{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark",
  "title": "benchmark",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "engine_id",
    "metric",
    "value",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "benchmark"
    },
    "name": {
      "type": "string"
    },
    "engine_id": {
      "type": "string"
    },
    "accelerator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interconnect_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "format_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric": {
      "enum": [
        "decode_tok_s",
        "prefill_tok_s",
        "ttft_ms",
        "tps_aggregate",
        "itl_ms",
        "memory_gb",
        "tok_s_per_user",
        "quality"
      ]
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "methodology": {
      "type": "string",
      "description": "batch size, prompt len, output len, concurrency, tensor parallel size"
    },
    "measured_by": {
      "enum": [
        "vendor",
        "third_party",
        "self"
      ]
    },
    "reproducible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
