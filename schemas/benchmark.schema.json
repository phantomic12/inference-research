{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark",
  "title": "benchmark",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "engine_id",
    "metric",
    "value",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "benchmark"
    },
    "name": {
      "type": "string"
    },
    "engine_id": {
      "type": "string"
    },
    "accelerator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interconnect_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "format_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric": {
      "enum": [
        "decode_tok_s",
        "prefill_tok_s",
        "ttft_ms",
        "tps_aggregate",
        "itl_ms",
        "memory_gb",
        "tok_s_per_user",
        "quality",
        "joules_per_token"
      ]
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "methodology": {
      "type": "string",
      "description": "batch size, prompt len, output len, concurrency, tensor parallel size"
    },
    "measured_by": {
      "enum": [
        "vendor",
        "third_party",
        "self"
      ]
    },
    "reproducible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    },
    "energy_basis": {
      "type": [
        "string",
        "null"
      ],
      "description": "REQUIRED when metric=joules_per_token. The measurement window, e.g. 'post-ramp core of 3634 1Hz samples, first 5% discarded'."
    },
    "power_w": {
      "type": [
        "number",
        "null"
      ],
      "description": "Mean watts underlying the joules figure."
    },
    "power_scope": {
      "enum": [
        "node",
        "device",
        "rack",
        null
      ],
      "description": "An 8-GPU NODE figure is NOT a per-GPU figure. Always state which."
    },
    "power_cap": {
      "type": [
        "number",
        "null"
      ],
      "description": "Enforced W cap during the run, if any. MLPerf 'MaxQ' is NOT a watt cap."
    },
    "clock_lock_mhz": {
      "type": [
        "number",
        "null"
      ],
      "description": "null if clocks were unlocked, else the -lgc value. A locked-clock number is not a stock-boost number."
    },
    "thermal_state": {
      "enum": [
        "steady",
        "unknown",
        null
      ],
      "description": "'steady' only if the run held a thermal plateau. A short run measures the ramp and biases energy LOW."
    }
  },
  "additionalProperties": false
}
