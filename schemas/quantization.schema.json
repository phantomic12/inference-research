{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantization",
  "title": "quantization",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "scheme",
    "bits",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "quantization"
    },
    "name": {
      "type": "string"
    },
    "scheme": {
      "enum": [
        "awq",
        "gptq",
        "exl2",
        "gguf-q2_k",
        "gguf-q3_k_m",
        "gguf-q4_0",
        "gguf-q4_k_m",
        "gguf-q4_k_s",
        "gguf-q5_k_m",
        "gguf-q6_k",
        "gguf-q8_0",
        "gguf-fp16",
        "fp8-e4m3",
        "fp8-e5m2",
        "fp8-blockwise",
        "nvfp4",
        "mxfp4",
        "mxfp8",
        "int8",
        "int8-channelwise",
        "smoothquant",
        "bitsandbytes-nf4",
        "bitsandbytes-int8",
        "hqq",
        "quarx",
        "spinquant",
        "ternary",
        "bitnet-b158",
        "wq4a4",
        "modelopt",
        "quanto",
        "optimum-quanto",
        "qat",
        "omniquant",
        "zeroquant",
        "aqlm",
        "quip",
        "lqer",
        "squeezellm",
        "atom",
        "flute",
        "quarot",
        "w4a8kv4",
        "kv-cache-quant",
        "kv-eviction",
        "kv-sparsity",
        "gguf-iq1-s",
        "gguf-iq1-m",
        "gguf-iq2-xxs",
        "gguf-iq2-xs",
        "gguf-iq2-s",
        "gguf-iq2-m",
        "gguf-iq3-xxs",
        "gguf-iq3-xs",
        "gguf-iq3-s",
        "gguf-iq3-m",
        "gguf-iq4-xs",
        "gguf-iq4-nl",
        "gguf-tq1-0",
        "gguf-tq2-0",
        "gguf-q4-1",
        "gguf-q5-1",
        "gguf-imatrix",
        "ort-matmulnbits-int4",
        "mlc-q4f16",
        "llmcompressor-compressed-tensors",
        "mxfp6",
        "llm-fp4"
      ]
    },
    "bits": {
      "type": "string",
      "description": "e.g. '4', 'w4a16', '3.2 avg'"
    },
    "weight_group_size": {
      "type": [
        "number",
        "null"
      ]
    },
    "activation_scheme": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emulated_support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kernels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_delta": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
