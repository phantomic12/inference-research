{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accelerator",
  "title": "accelerator",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "accelerator"
    },
    "name": {
      "type": "string"
    },
    "vendor": {
      "enum": [
        "nvidia",
        "amd",
        "intel",
        "qualcomm",
        "apple",
        "broadcom",
        "google",
        "amazon",
        "microsoft",
        "meta",
        "cerebras",
        "groq",
        "tenstorrent",
        "cambricon",
        "samba",
        "asic-other",
        "other"
      ]
    },
    "architecture": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "process_nm": {
      "type": [
        "integer",
        "null"
      ]
    },
    "form_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vram_gb": {
      "type": [
        "number",
        "null"
      ],
      "description": "HBM or VRAM per device/package. Multi-die parts: see notes."
    },
    "memory_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_bus_bit": {
      "type": [
        "integer",
        "null"
      ]
    },
    "memory_bandwidth_gbps": {
      "type": [
        "number",
        "null"
      ]
    },
    "memory_bandwidth_basis": {
      "type": [
        "string",
        "null"
      ],
      "description": "How the bandwidth figure was derived, e.g. 'GDDR6 28Gbps x 384-bit'."
    },
    "flops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "precision",
          "tflops"
        ],
        "properties": {
          "precision": {
            "enum": [
              "fp32",
              "tf32",
              "bf16",
              "fp16",
              "fp8",
              "fp6",
              "fp4",
              "int8",
              "int4",
              "fp4_block_scaled",
              "other"
            ]
          },
          "tflops": {
            "type": "number"
          },
          "dense": {
            "type": "boolean",
            "default": true
          },
          "vendor_claim": {
            "type": "boolean",
            "default": true
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tdp_w": {
      "type": [
        "number",
        "null"
      ]
    },
    "interconnect": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unified_memory": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "consumer": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
