{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source",
  "title": "source",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "status",
    "confidence",
    "updated",
    "url",
    "kind",
    "accessed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "source"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string"
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "spec-sheet",
        "whitepaper",
        "paper",
        "benchmark",
        "repo",
        "release-notes",
        "forum",
        "blog",
        "interview",
        "review",
        "database"
      ]
    },
    "published": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "archived_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
