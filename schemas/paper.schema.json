{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper",
  "title": "paper",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "arxiv_id",
    "venue",
    "category",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "paper"
    },
    "name": {
      "type": "string"
    },
    "arxiv_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "e.g. 2408.11743; null when no arXiv version exists"
    },
    "venue": {
      "enum": [
        "arxiv-preprint",
        "neurips",
        "icml",
        "iclr",
        "acl",
        "emnlp",
        "naacl",
        "cvpr",
        "iccv",
        "eccv",
        "osdi",
        "sosp",
        "nsdi",
        "atc",
        "eurosys",
        "asplos",
        "micro",
        "isca",
        "mlsys",
        "vldb",
        "sigmod",
        "kdd",
        "www",
        "interspeech",
        "icassp",
        "colm",
        "other"
      ]
    },
    "venue_track": {
      "enum": [
        "main",
        "findings",
        "workshop",
        "industry",
        "unknown",
        null
      ],
      "description": "which track within the venue. Added because ACL-family Findings and EACL were UNDER-CLAIMED: a Findings paper has no honest value in `venue`, and `other` cannot separate 'published at a second-tier venue' from 'venue not yet known'. Additive only — `venue` is untouched so no existing paper record can break. findings = the companion proceedings volume; workshop = a workshop paper; industry = industry track (SysML, ICPE); unknown = track not established.",
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "category": {
      "enum": [
        "attention",
        "kv-cache",
        "quantization",
        "moe",
        "ssm",
        "speculative-decoding",
        "serving-systems",
        "scheduling",
        "distillation",
        "long-context",
        "position-encoding",
        "sparsity",
        "pruning",
        "routing",
        "inference-time-compute",
        "agentic",
        "multimodal",
        "speech",
        "embedding",
        "retrieval",
        "structured-output",
        "security",
        "cluster",
        "interconnect",
        "training-inference-bridge",
        "other"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problem": {
      "type": [
        "string",
        "null"
      ],
      "description": "the bottleneck it attacks, in one sentence"
    },
    "mechanism": {
      "type": [
        "string",
        "null"
      ],
      "description": "how it works, concretely enough to implement"
    },
    "hardware_relevance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "bare accelerator ids where the method's benefit is hardware-dependent"
    },
    "speedup_reported": {
      "type": [
        "string",
        "null"
      ],
      "description": "the paper's own claim, with baseline and settings; never a bare number"
    },
    "adoption": {
      "enum": [
        "in-production",
        "in-upstream-engine",
        "research-only",
        "abandoned",
        "unknown"
      ]
    },
    "code_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "open_weights": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
