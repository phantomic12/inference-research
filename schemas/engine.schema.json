{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine",
  "title": "engine",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "engine"
    },
    "name": {
      "type": "string"
    },
    "repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_release_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "design_goal": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scheduling": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "continuous-batching | paged-kv | radix-cache | prefix-cache | chunked-prefill | none"
    },
    "supported_backends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "cuda | rocm | hip | metal | vulkan | cpu-avx512 | cpu-avx2 | opencl | tpu | xnnpack | npu"
    },
    "supported_formats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "gguf | safetensors | awq | gptq | exl2 | marlin | onnx | mxfp4 | nvfp4 | deepspeed-moe | ..."
    },
    "notable_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hardware_caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "best_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
