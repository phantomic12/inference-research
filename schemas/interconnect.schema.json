{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interconnect",
  "title": "interconnect",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "kind",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "interconnect"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "nvlink",
        "nvswitch",
        "infinity-band",
        "xgmi",
        "uefi",
        "infiniband",
        "ethernet",
        "roce",
        "pcie",
        "cxl",
        "hstx",
        "uvm",
        "sxm-c2c",
        "xcd",
        "waa",
        "other"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "bandwidth_gbps": {
      "type": [
        "number",
        "null"
      ],
      "description": "per link, unidirectional"
    },
    "bandwidth_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "link_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "topology": {
      "type": [
        "string",
        "null"
      ]
    },
    "scale_up": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "scale_out": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "switching": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
