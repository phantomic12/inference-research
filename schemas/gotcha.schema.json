{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gotcha",
  "title": "gotcha",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "class",
    "symptom",
    "status",
    "confidence",
    "updated",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "const": "gotcha"
    },
    "name": {
      "type": "string"
    },
    "class": {
      "enum": [
        "driver",
        "kernel",
        "framework",
        "config",
        "hardware",
        "format",
        "toolchain",
        "measurement",
        "build"
      ]
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symptom": {
      "type": "string"
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "workaround": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "enum": [
        "blocker",
        "major",
        "minor"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "contested",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "source ids; each must exist in data/sources/"
    }
  },
  "additionalProperties": false
}
