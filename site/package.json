{
  "name": "inference-research-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static browse/search site over the inference-research record corpus",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "build": "astro build && npm run index",
    "index": "pagefind --site dist",
    "dev": "astro dev",
    "preview": "astro preview",
    "data": "python ../tools/build_site_data.py",
    "check:data": "python ../tools/build_site_data.py --check",
    "verify": "python scripts/verify_dist.py",
    "verify:search": "node scripts/search_test.mjs",
    "verify:browser": "node scripts/search_dom_test.mjs",
    "shots": "node scripts/shots.mjs",
    "verify:all": "npm run verify && npm run verify:search && npm run verify:browser"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
