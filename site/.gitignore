# Astro's build output and dependency tree — never committed. The site is
# rebuilt from data/ on demand, so dist/ and .astro/ are pure artefacts.
node_modules/
dist/
.astro/

# Pagefind's search index is part of dist/, but Astro also drops it in .astro/.
.pagefind/

# Screenshots written by scripts/shots.mjs (repo root, not site/).
../.site-shots/

# Generated by tools/build_site_data.py. This payload is a build artefact of
# data/ + docs/ — committing it would guarantee it goes stale against the
# records, which are written concurrently. Regenerate with `npm run data`.
src/data/records/
src/data/index/
src/data/meta.json
src/data/docs.json
src/data/search-index.json
src/data/graph.json
src/data/names.json

# Compare matrices and facet maps, also emitted by build_site_data.py.
public/c/
public/type-list.json
public/facets.json
public/titles.json

# Joined-view JSON payloads emitted by build_joined_views.py.
public/joined/

# Env / editor / OS noise
.env
.env.production
.DS_Store
*.log
.idea/
.vscode/