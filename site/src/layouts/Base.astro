---
import { META, PRIMARY_TYPES, typeUrl, recUrl } from '../lib/data';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Marks the active top-nav entry: a type name, 'docs', 'graph', 'compare', ... */
  nav?: string;
  /** Pagefind facets for this page: type, status, rid. */
  pf?: { type?: string; status?: string; rid?: string; title?: string; summary?: string };
}

const { title, description, nav, pf } = Astro.props;
const metaDescription = description ?? `${title} · inference-research`;
// Astro.url.pathname includes the configured base. Resolving it against the
// configured site keeps canonical URLs correct on the deployed subpath.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const NAV_SHORT: Record<string, string> = {
  flop: 'FLOPs',
  engine: 'Engines',
  quantization: 'Quants',
  supply: 'Supply',
  service: 'APIs',
  compiler: 'Compilers',
  metric_exposure: 'Metrics',
  kv_efficiency: 'KV cache',
};
const total = META.total.toLocaleString();
const contested = META.status.contested ?? 0;
const draft = META.status.draft ?? 0;
// /agentic/ exists in this branch's tree; use the absolute base-URL form like
// every other top-level destination so the link is identical from any depth.
const basePath = import.meta.env.BASE_URL;
const agenticHref = `${basePath}agentic/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · inference-research</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:title" content={`${title} · inference-research`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · inference-research`} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="color-scheme" content="dark" />
        <!-- Pagefind reads these <meta> tags for the type/status/rid filters on
             /search/, so their values are the record's own fields. -->
        {pf?.type && <meta data-pagefind-meta="type" content={pf.type} />}
        {pf?.status && <meta data-pagefind-meta="status" content={pf.status} />}
        {pf?.rid && <meta data-pagefind-meta="rid" content={pf.rid} />}
        <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
      </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="brand" href={import.meta.env.BASE_URL}>inference<span class="caret">/</span>research</a>
        <nav class="nav nav-questions" aria-label="Questions">
          <a href={agenticHref} aria-current={nav === 'agentic' ? 'page' : undefined}>Agentic</a>
          <a href={`${import.meta.env.BASE_URL}worth/`} aria-current={nav === 'worth' ? 'page' : undefined}>Worth</a>
          <a href={`${import.meta.env.BASE_URL}cost/`} aria-current={nav === 'cost' ? 'page' : undefined}>Cost</a>
          <a href={`${import.meta.env.BASE_URL}compat/`} aria-current={nav === 'compat' ? 'page' : undefined}>Compat</a>
        </nav>
        <div class="searchbox">
          <input
            type="search"
            id="q"
            placeholder={`Search ${total} records…  /`}
            autocomplete="off"
            spellcheck="false"
            aria-label="Search all records"
            aria-controls="sr"
            aria-expanded="false"
          />
          <div class="search-results" id="sr" role="listbox" aria-label="Search results"></div>
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light/dark theme" title="Toggle light/dark theme">◐</button>
        <details class="nav-more">
          <summary>More</summary>
          <div class="nav-more-menu">
            <nav class="nav nav-questions nav-questions-mobile" aria-label="Questions">
              <a href={agenticHref} aria-current={nav === 'agentic' ? 'page' : undefined}>Agentic</a>
              <a href={`${import.meta.env.BASE_URL}worth/`} aria-current={nav === 'worth' ? 'page' : undefined}>Worth</a>
              <a href={`${import.meta.env.BASE_URL}cost/`} aria-current={nav === 'cost' ? 'page' : undefined}>Cost</a>
              <a href={`${import.meta.env.BASE_URL}compat/`} aria-current={nav === 'compat' ? 'page' : undefined}>Compat</a>
            </nav>
            <nav class="nav nav-more-links" aria-label="More views">
              <a href={`${import.meta.env.BASE_URL}roofline/`} aria-current={nav === 'roofline' ? 'page' : undefined}>Roofline</a>
              <a href={`${import.meta.env.BASE_URL}per-dollar/`} aria-current={nav === 'perdollar' ? 'page' : undefined}>FLOPS-per-dollar</a>
              <a href={`${import.meta.env.BASE_URL}graph/`} aria-current={nav === 'graph' ? 'page' : undefined}>Graph</a>
              <a href={`${import.meta.env.BASE_URL}docs/`} aria-current={nav === 'docs' ? 'page' : undefined}>Docs</a>
              <a href={`${import.meta.env.BASE_URL}compare/`} aria-current={nav === 'compare' ? 'page' : undefined}>Compare</a>
              <a href={`${import.meta.env.BASE_URL}search/`} aria-current={nav === 'search' ? 'page' : undefined}>Search</a>
            </nav>
          </div>
        </details>
      </div>
    </header>

    <slot />

    <footer class="wrap site-footer">
      <p style="margin:0">
        Generated from <code>data/</code> by <code>tools/build_site_data.py</code> —
        {total} records, {META.mean_confidence?.toFixed(2)} mean confidence,
        <span class="status status-contested" style="font-size:.65rem">contested {contested}</span>
        <span class="status status-draft" style="font-size:.65rem">draft {draft}</span>.
        Every number on this site traces to a record, and every record to the
        <a href={typeUrl('source')}>{META.counts.source} sources</a> it was checked against.
      </p>
      <nav class="nav nav-types type-strip" aria-label="Record types">
        {PRIMARY_TYPES.map((t) => (
          <a href={typeUrl(t.type)} aria-current={nav === t.type ? 'page' : undefined}>{NAV_SHORT[t.type] ?? t.title}</a>
        ))}
      </nav>
      <nav class="nav nav-provenance" aria-label="Provenance">
        <a href={typeUrl('source')} title={`${META.counts.source} cited sources`}>
          Sources ({META.counts.source})
        </a>
      </nav>
    </footer>

    <script>
      // Theme toggle: respects prefers-color-scheme, stores override in localStorage
      (function() {
        const btn = document.getElementById('theme-toggle');
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        if (btn) {
          btn.addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });
        }
      })();
    </script>

    <script>
      // Masthead quick search, sharing the Pagefind-backed module with /search/
          // so both rank and filter identically. The index is built after
          // `astro build`, so the box reports that plainly when it is missing (dev).
          import { escapeHtml, highlight, queryTerms, runSearch } from '../lib/search';
          import { META } from '../lib/data';

      const input = document.getElementById('q') as HTMLInputElement | null;
      const panel = document.getElementById('sr') as HTMLElement | null;

      if (input && panel) {
        let timer: number | undefined;
        let seq = 0;

        async function run() {
          const q = input!.value.trim();
          if (q.length < 2) {
            panel!.removeAttribute('data-open');
            input!.setAttribute('aria-expanded', 'false');
            return;
          }
          const mine = ++seq;
          panel!.innerHTML = '<p class="search-empty">Searching…</p>';
          panel!.setAttribute('data-open', 'true');

          const hits = await runSearch(q);
          if (mine !== seq) return;

          if (hits === null) {
            panel!.innerHTML =
              '<p class="search-empty">Search index not built. Run <code>npm run build</code>, ' +
              'then serve <code>dist/</code>.</p>';
            return;
          }
          const terms = queryTerms(q);
          if (!hits.length) {
            panel!.innerHTML = `<p class="search-empty">No records match “${escapeHtml(q)}”.</p>`;
          } else {
            panel!.innerHTML =
              '<ol>' +
              hits
                .slice(0, 14)
                .map(
                  (h) => `<li><a href="${h.url}">
                    <span class="sr-name">${highlight(escapeHtml(h.title), terms)}</span>
                    <span class="sr-meta">${
                      h.status
                        ? `<span class="status status-${escapeHtml(h.status)}">${escapeHtml(h.status)}</span>`
                        : '<span class="status status-verified">doc</span>'
                    }<span>${escapeHtml(h.type)}</span>${
                      h.rid ? `<span>${escapeHtml(h.rid)}</span>` : ''
                    }</span>
                    ${h.summary ? `<span class="sr-snip">${highlight(escapeHtml(h.summary), terms)}</span>` : ''}
                  </a></li>`,
                )
                .join('') +
              '</ol>';
          }
          input!.setAttribute('aria-expanded', 'true');
        }

        input.addEventListener('input', () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(run, 130) as unknown as number;
        });
        input.addEventListener('focus', () => {
          if (input.value.trim().length >= 2) run();
        });
        document.addEventListener('keydown', (ev) => {
          const ke = ev as KeyboardEvent;
          if (ke.key === '/' && document.activeElement?.tagName !== 'INPUT') {
            ke.preventDefault();
            input.focus();
            input.select();
          }
          if (ke.key === 'Escape') {
            panel!.removeAttribute('data-open');
            input!.blur();
          }
        });
        document.addEventListener('click', (ev) => {
          const t = ev.target as Node;
          if (!panel!.contains(t) && t !== input) panel!.removeAttribute('data-open');
        });
      }
    </script>
  </body>
</html>