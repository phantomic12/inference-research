---
import type { GetStaticPaths } from 'astro';
import BenchmarkIndex from '../../components/BenchmarkIndex.astro';
import { BENCHMARK_PAGE_SIZE } from '../../components/benchmark-page';
import { META } from '../../lib/data';
import type { Row, TypeInfo } from '../../lib/data';

// Page 1 is rendered by the generic [type]/index.astro route at /benchmark/.
// This route owns only continuation pages, which keeps the route table and the
// first-page URL unchanged while slicing the large benchmark list.
export const getStaticPaths = (async () => {
  const info = META.types.find((t) => t.type === 'benchmark');
  if (!info) return [];

  const rows = (await import('../../data/index/benchmark.json')).default as Row[];
  const pageCount = Math.ceil(rows.length / BENCHMARK_PAGE_SIZE);

  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: { info, rows, page },
    };
  });
}) satisfies GetStaticPaths;

const { info, rows, page } = Astro.props as {
  info: TypeInfo;
  rows: Row[];
  page: number;
};
---

<BenchmarkIndex info={info} rows={rows} page={page} pageSize={BENCHMARK_PAGE_SIZE} />
