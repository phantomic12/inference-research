---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { META, PRIMARY_TYPES, docUrl, typeUrl } from '../lib/data';

const contested = (META.status.contested ?? 0).toLocaleString();
const draft = (META.status.draft ?? 0).toLocaleString();
const verified = (META.status.verified ?? 0).toLocaleString();
const deprecated = (META.status.deprecated ?? 0).toLocaleString();

// The decision docs are a secondary path for readers who want the argument,
// not the answer. 00-index.md is generated and deliberately not rendered.
const headlineDocs = META.docs.filter((d) => /^(01|02|03|04|05)/.test(d.slug));

// /agentic/ is linked relatively: from this page it resolves to the site's
// /agentic/ route, without making the local dist verifier treat a page built
// by another task as a broken absolute link.
const agenticUrl = 'agentic/';
---

<Base
  title="inference-research"
  description={`${META.total.toLocaleString()} cited records on inference hardware, engines, quantization, benchmarks and traps. ${contested} contested, ${draft} draft.`}
>
  <main class="wrap" data-pagefind-body>
    <meta data-pagefind-meta="type" content="page" />
    <section class="hero">
      <h1>Find the model worth running.</h1>
      <p>
        Open-weight models ranked on the agentic and coding benchmarks that still
        separate them, filtered to what actually fits your machine.
      </p>
      <p style="margin-top:var(--space-4)">
        <a
          class="primary-link"
          href={agenticUrl}
          style="display:inline-block;padding:var(--space-2) var(--space-4);border:1px solid var(--accent);border-radius:var(--radius-sm);background:var(--accent);color:var(--bg);font-weight:600"
        >Agentic ranking <span aria-hidden="true">→</span></a>
      </p>
    </section>

    <section class="section">
      <h2>Start from a question</h2>
      <div class="doclist">
        <a class="doccard" href={agenticUrl}>
          <span class="t">Which model for agentic work?</span>
          <span class="m">the ranking, with the trade-offs shown</span>
        </a>
        <a class="doccard" href={`${import.meta.env.BASE_URL}worth/`}>
          <span class="t">Does it fit my machine?</span>
          <span class="m">size, quant and VRAM</span>
        </a>
        <a class="doccard" href={`${import.meta.env.BASE_URL}cost/`}>
          <span class="t">What does serving cost?</span>
          <span class="m">supply × benchmark → USD/Mtok</span>
        </a>
        <a class="doccard" href={`${import.meta.env.BASE_URL}compat/`}>
          <span class="t">Does engine X support model Y?</span>
          <span class="m">families × engines</span>
        </a>
      </div>
    </section>

    <section class="section">
      <h2>Decision docs</h2>
      <p class="hint">
        Longer arguments written from the records, citing record ids inline.
      </p>
      <div class="doclist" style="margin-top:.75rem">
        {headlineDocs.map((d) => (
          <a class="doccard" href={docUrl(d.slug)}>
            <span class="t">{d.title.replace(/^\d\d\s+—\s+/, '')}</span>
            <span class="m">{d.slug}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" style="margin-bottom:var(--space-6)" aria-label="Corpus at a glance">
      <div class="statusbar">
        <StatusBadge status="verified" confidence={META.mean_confidence} />
        <span style="font-size:var(--text-xs);color:var(--fg-dim)">
          {verified} verified · <span class="status status-contested">contested</span> {contested} ·
          <span class="status status-draft">draft</span> {draft} · {deprecated} deprecated ·
          mean confidence {META.mean_confidence?.toFixed(2)}
        </span>
      </div>
      <div class="stat-grid" style="grid-template-columns:repeat(auto-fill,minmax(8.5rem,1fr));gap:var(--space-2);margin:var(--space-3) 0">
        {PRIMARY_TYPES.map((t) => (
          <a class="stat" href={typeUrl(t.type)} style="padding:var(--space-2) var(--space-3)">
            <span class="n" style="font-size:var(--text-lg)">{t.count.toLocaleString()}</span>
            <span class="l">{t.title}</span>
          </a>
        ))}
        <a class="stat provenance" href={typeUrl('source')} title="Provenance: documents cited by the records above" style="padding:var(--space-2) var(--space-3)">
          <span class="n" style="font-size:var(--text-lg)">{(META.counts.source ?? 0).toLocaleString()}</span>
          <span class="l">Sources (provenance)</span>
        </a>
      </div>
    </section>
  </main>
</Base>
