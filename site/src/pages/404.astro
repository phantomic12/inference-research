---
import Base from '../layouts/Base.astro';
import { META, PRIMARY_TYPES, typeUrl } from '../lib/data';
---

<Base title="Not found" description="No such page in the inference-research site.">
  <main class="wrap" data-pagefind-body>
    <meta data-pagefind-meta="type" content="page" />
    <div class="page-head">
      <h1>No such record</h1>
      <p class="sub">
        That page does not exist in this build. If you followed a link from a record, the
        target id may name a record that does not exist yet — the pipeline reports those
        rather than linking them.
      </p>
    </div>
    <section class="section">
      <h2>Try a type index</h2>
      <div class="stat-grid">
        {PRIMARY_TYPES.map((t) => (
          <a class="stat" href={typeUrl(t.type)}>
            <span class="n">{t.count.toLocaleString()}</span>
            <span class="l">{t.title}</span>
          </a>
        ))}
      </div>
      <p><a href="/search/">Search all {META.total.toLocaleString()} records →</a></p>
    </section>
  </main>
</Base>