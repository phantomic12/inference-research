---
import Base from '../../layouts/Base.astro';
import { DOCS, META } from '../../lib/data';

type Doc = typeof DOCS[number];

const GROUPS: { kind: Doc['kind']; label: string; desc: string }[] = [
  { kind: 'reader', label: 'Start here', desc: 'The decision guides: which hardware, engine, quant, or topology to run, and what it costs.' },
  { kind: 'reference', label: 'Reference', desc: 'Methodology, vocabulary, and compatibility lookups you consult while making a decision.' },
  { kind: 'ledger', label: 'Engineering ledgers', desc: 'Audit findings, known defects, and citation-integrity records: the debt and integrity log.' },
];

const byKind = (kind: Doc['kind']): Doc[] => DOCS.filter((d) => d.kind === kind);
---

<Base title="Docs" nav="docs" description="Synthesis docs over the inference-research corpus." pf={{ type: 'doc' }}>
  <main class="wrap" data-pagefind-body>
    <meta data-pagefind-meta="type" content="doc" />
    <div class="page-head">
      <h1>Docs</h1>
      <p class="sub">
        {DOCS.length} synthesis documents written from the records, citing record ids
        inline. Every quantitative claim in a doc traces to a record you can open from
        the doc itself. <code>docs/00-index.md</code> is generated by
        <code>tools/index.py</code> and is not rendered here.
      </p>
    </div>

    {GROUPS.map((g) => (
      byKind(g.kind).length > 0 ? (
        <section class="section">
          <h2 class="grouptitle">{g.label}</h2>
          <p class="groupdesc">{g.desc}</p>
          <div class="doclist">
            {byKind(g.kind).map((d) => (
              <a class="doccard" href={`/docs/${d.slug}/`}>
                <span class="t">{d.title.replace(/^\d\d\s+—\s+/, '')}</span>
                {d.blurb ? <span class="b">{d.blurb}</span> : null}
              </a>
            ))}
          </div>
        </section>
      ) : null
    ))}
  </main>
</Base>

<style>
  .grouptitle { font-size: var(--text-lg); }
  .groupdesc { color: var(--fg-dim); margin: 0 0 var(--space-3); }
  .doccard .b { display: block; color: var(--fg-dim); font-size: var(--text-sm); line-height: 1.4; }
</style>
