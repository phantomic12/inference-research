---
import Base from '../../layouts/Base.astro';
import { DOCS, META } from '../../lib/data';
---

<Base title="Docs" nav="docs" description="Synthesis docs over the inference-research corpus." pf={{ type: 'doc' }}>
  <main class="wrap" data-pagefind-body>
    <meta data-pagefind-meta="type" content="doc" />
    <div class="page-head">
      <h1>Docs</h1>
      <p class="sub">
        {DOCS.length} synthesis documents written from the records, citing record ids
        inline. Every quantitative claim in a doc traces to a record you can open from
        the doc itself. <code>docs/00-index.md</code> is generated by
        <code>tools/index.py</code> and is not rendered here.
      </p>
    </div>

    <section class="section">
      <h2>Decision docs</h2>
      <div class="doclist">
        {DOCS.map((d) => (
          <a class="doccard" href={`/docs/${d.slug}/`}>
            <span class="t">{d.title.replace(/^\d\d\s+—\s+/, '')}</span>
            <span class="m">{d.slug} · {d.chars.toLocaleString()} chars</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>